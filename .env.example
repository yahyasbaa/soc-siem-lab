# SOC & SIEM Security Monitoring Lab - environment configuration
#
# `make setup` copies this file to .env and replaces every value marked
# __GENERATE__ with a random lab-only secret. These credentials exist only
# inside this local lab; never reuse real credentials here.

COMPOSE_PROJECT_NAME=soclab
WAZUH_VERSION=4.14.8
NGINX_IMAGE=nginx:1.27-alpine

# Wazuh indexer (OpenSearch) superuser used by Filebeat, tests and dashboards import
INDEXER_USERNAME=admin
INDEXER_PASSWORD=__GENERATE__

# Internal user the dashboard server uses to talk to the indexer
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=__GENERATE__

# Wazuh manager REST API user (also used for logtest-based detection tests)
API_USERNAME=wazuh-wui
API_PASSWORD=__GENERATE__

# Indexer JVM heap. 1g is enough for the lab; raise on bigger hosts.
INDEXER_JAVA_OPTS="-Xms1g -Xmx1g"

# Host ports. All are bound to 127.0.0.1 only, so nothing is exposed to the network.
INDEXER_PORT=9200
API_PORT=55000
DASHBOARD_PORT=5601
